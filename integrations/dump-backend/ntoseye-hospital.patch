-    let response = reqwest::blocking::get(url)?;
+    // Bound a deployment's symbol-server requests; unchanged upstream default
+    // when the environment variable is absent.
+    let response = if let Ok(seconds) = std::env::var("PC_HOSPITAL_SYMBOL_TIMEOUT_SECS") {
+        let seconds = seconds.parse::<u64>().unwrap_or(12).clamp(1, 60);
